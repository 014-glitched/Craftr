# Environment template — copy values into apps/api/.env and apps/web/.env.local

# --- Shared / API (apps/api/.env) ---
# Prefer Neon (hosted Postgres). Docker/local Postgres is optional.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# REDIS_URL is optional until queues/presence phases
# REDIS_URL="redis://localhost:6379"
BETTER_AUTH_SECRET="dev-secret-change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
PORT=4000

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

{
  "name": "craftr",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @craftr/database generate",
    "db:migrate": "pnpm --filter @craftr/database migrate:dev",
    "db:push": "pnpm --filter @craftr/database push",
    "db:studio": "pnpm --filter @craftr/database studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
